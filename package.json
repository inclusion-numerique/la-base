{
  "name": "la-base",
  "description": "La Base - Monorepo",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": "^24.21"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm -r build",
    "cli": "dotenv -- ./apps/cli/node_modules/.bin/tsx apps/cli/src/index.ts",
    "clean": "rm -rf node_modules",
    "clean:workspaces": "pnpm -r exec rm -rf node_modules",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,css}\"",
    "lint": "pnpm -r lint",
    "tsc": "pnpm -r tsc",
    "test": "pnpm -r test",
    "test:integration": "pnpm -F web test:integration",
    "test:e2e": "pnpm -F e2e cy open",
    "with-env": "dotenv --",
    "scw": "pnpm with-env scw",
    "manypkg": "manypkg",
    "start:web": "pnpm -F web dev",
    "fixtures:load": "pnpm -F fixtures load",
    "prisma:generate-migration": "pnpm --silent -F @app/web prisma migrate dev --name",
    "db:init": "pnpm -F web prisma generate && pnpm -F web prisma migrate deploy",
    "docker:start": "docker compose -f ./docker-compose.dev.yml -p stack up -d",
    "docker:stop": "docker compose -f ./docker-compose.dev.yml -p stack down",
    "docker:reset": "pnpm docker:stop && docker volume rm la-base_pgdata && pnpm docker:start && pnpm db:init",
    "lint:commit": "commitlint --from origin/main",
    "prepare": "husky"
  },
  "volta": {
    "node": "24.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@manypkg/cli": "^0.25.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7"
  }
}
