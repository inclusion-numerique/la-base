    "react-dom": "^19.2.8",
    "storybook": "^10.5.7"
  },
  "devDependencies": {
    "@storybook/test-runner": "^0.24.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
