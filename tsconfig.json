{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node", "jest"],
    "paths": {
      "@app/cli/*": ["./apps/cli/src/*"],
      "@app/web/*": ["./apps/web/src/*"],
      "@app/cdk/*": ["./packages/cdk/src/*"],
      "@app/config/*": ["./packages/config/src/*"],
      "@app/e2e/*": ["./packages/e2e/cypress/*"],
      "@app/emails/*": ["./packages/emails/src/*"],
      "@app/lint/*": ["./packages/lint/src/*"],
      "@app/fixtures/*": ["./packages/fixtures/src/*"],
      "@app/scaleway/*": ["./packages/cdk/.gen/providers/scaleway/*"],
      "@app/storybook/*": ["./packages/storybook/src/*"],
      "@app/ui/*": ["./packages/ui/src/*"],
      "@app/test/*": ["./packages/test/src/*"],
      // `@prisma/client` se résout vers plusieurs instances du store pnpm (une par
      // combinaison de pairs), alors que `prisma generate` n'en peuple qu'une. On force
      // tous les workspaces sur celle d'apps/web. Chemin stable, contrairement au chemin
      // de store d'origine dont le hash incluait la version de TypeScript.
      "@prisma/client": ["./apps/web/node_modules/@prisma/client"]
    }
  },
  "include": ["./packages/test/src/jest.setup.ts"],
  "files": ["./packages/test/node_modules/jest-extended/types/index.d.ts"],
  "exclude": ["./node_modules"]
}
